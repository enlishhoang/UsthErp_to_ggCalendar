{
  "manifest_version": 3,
  "name": "USTH ERP → Google Calendar",
  "version": "6.1.0",
  "key": "",
  "description": "Đồng bộ thời khóa biểu USTH ERP sang Google Calendar.",
  "icons": {
    "48": "ErpGd-48.png"
  },
  "permissions": ["storage", "identity", "declarativeNetRequest"],
  "host_permissions": [
    "https://erp.usth.edu.vn/*",
    "https://www.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "USTH ERP → Google Calendar",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "usth-erp-gcal@local",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
